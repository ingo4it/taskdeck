{
  "name": "taskdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack team workspace for background jobs + AI document review, built on keystone / pulseq / modelgate.",
  "author": "Frank Rao <frank@frankrao.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
