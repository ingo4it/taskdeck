    "test:watch": "vitest",
    "e2e": "playwright test",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "next": "15.0.3",
    "next-themes": "^0.4.3",
