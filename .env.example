# ---- this app ----
# public URL the browser loads; used to build OIDC return_to
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- demo mode ----
# swaps keystone/pulseq/modelgate for in-process fixtures (see README's Demo
# mode section) instead of the three URLs below — leave both unset/false for
# a real deployment.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# ---- upstream services (server-side only; never exposed to the browser) ----
# required unless DEMO_MODE=true
KEYSTONE_URL=http://localhost:8080
PULSEQ_ADMIN_URL=http://localhost:7411
MODELGATE_URL=http://localhost:8000

# ---- session ----
# 32+ byte secret for the session cookie (AES-GCM)
SESSION_SECRET=dev-only-session-secret-change-me-please
SESSION_COOKIE=td_session
SESSION_TTL_SECONDS=86400

# ---- realtime ----
# WebSocket endpoint for presence (keystone or a dedicated gateway); required
# unless NEXT_PUBLIC_DEMO_MODE=true, which disables presence instead
NEXT_PUBLIC_PRESENCE_WS_URL=ws://localhost:8080/ws/presence
